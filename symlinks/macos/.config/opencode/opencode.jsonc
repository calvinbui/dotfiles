{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-opus-5-5",
  "websearch": {
    "provider": "native"
  },
  "providers": {
    "anthropic": {
      "settings": {
        "baseURL": "https://agentgateway.{file:~/.config/opencode/secrets/domain}/v1"
      },
      "models": {
        "claude-haiku-4-5-20251001": {
          "settings": {
            "websearch": "always"
          }
        }
      }
    }
  },
  "plugins": [
    "opencode-websearch"
  ],
  "skills": [
    "~/repos/skills"
  ],
  "mcp": {
    "servers": {
      "home_assistant_mcp": {
        "type": "remote",
        "url": "http://home-assistant-mcp:8086/mcp"
      },
      "actual-mcp-server": {
        "type": "remote",
        "url": "http://actual-mcp-server:3600/http",
        "headers": {
          "Authorization": "Bearer {file:~/.config/opencode/secrets/actual-mcp-token}"
        },
        "oauth": false
      },
      "mattermost": {
        "type": "remote",
        "url": "https://mattermost.{file:~/.config/opencode/secrets/domain}/plugins/mattermost-ai/mcp-server/mcp"
      },
      "fastmail": {
        "type": "remote",
        "url": "https://api.fastmail.com/mcp",
        "oauth": {
          "auth_server_metadata_url": "https://api.fastmail.com/.well-known/oauth-authorization-server"
        }
      },
      "playwright": {
        "type": "local",
        "command": [
          "{env:HOME}/.local/share/fnm/node-versions/v22.22.0/installation/bin/node",
          "{env:HOME}/.local/share/fnm/node-versions/v22.22.0/installation/lib/node_modules/npm/bin/npx-cli.js",
          "-y",
          "@playwright/mcp@0.0.84",
          "--extension",
          "--executable-path",
          "/Applications/Chromium.app/Contents/MacOS/Chromium"
        ],
        "environment": {
          "PATH": "{env:HOME}/.local/share/fnm/node-versions/v22.22.0/installation/bin:{env:PATH}",
          "PLAYWRIGHT_MCP_EXTENSION_TOKEN": "{file:~/.config/opencode/secrets/playwright-mcp-extension-token}"
        },
        "timeout": {
          "startup": 60000
        }
      }
    }
  }
}
