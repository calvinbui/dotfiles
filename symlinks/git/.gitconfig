[user]
	name = Calvin Bui
	email = 3604363+calvinbui@users.noreply.github.com

[core]
	excludesfile = ~/.gitignore_global
	ignorecase = false

[commit]
	gpgsign = true

[tag]
	gpgsign = true

[pull]
	rebase = true

[url "ssh://git@github.com/"]
	insteadOf = https://github.com/

[credential]
	helper = store

[safe]
	directory = *

[rebase]
	autostash = true
[push]
	autoSetupRemote = true

# Platform defaults, then machine-only overrides. Keep these includes last.
[include]
	path = ~/.config/git/platform.gitconfig
	path = ~/.gitlocal
